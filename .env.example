# LinguaVersa Environment Variables

# Backend Server Configuration
PORT=3001
NODE_ENV=production

# Database Connection (Supabase / PostgreSQL)
DATABASE_URL="postgresql://postgres:your_db_password@your_db_host:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:your_db_password@your_db_host:5432/postgres"

# Daily.co Managed Video Infrastructure API Key
# Obtain from https://dashboard.daily.co/developers
DAILY_API_KEY="your_daily_api_key_here"

# Frontend Vercel Configuration
VITE_BACKEND_URL="https://ligua-versa1.onrender.com"
