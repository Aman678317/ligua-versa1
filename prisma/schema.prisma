datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                    String                 @id @default(uuid())
  email                 String                 @unique
  passwordHash          String?
  authProvider          String                 @default("local") // "local", "google"
  name                  String
  avatarUrl             String?
  defaultLanguage       String                 @default("en")
  role                  String                 @default("USER") // "USER", "ADMIN"
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  deletedAt             DateTime?

  profile               Profile?
  sessions              Session[]
  devices               Device[]
  userRoles             UserRole[]
  teamMembers           TeamMember[]
  hostedMeetings        Meeting[]              @relation("MeetingHost")
  meetingParticipants   MeetingParticipant[]
  messages              Message[]
  recordings            Recording[]            @relation("UserRecordings")
  contacts              Contact[]              @relation("UserContacts")
  contactOf             Contact[]              @relation("ContactOwner")
  sentInvitations       MeetingInvitation[]    @relation("SentInvitations")
  notifications         Notification[]
  subscriptions         Subscription[]
  payments              Payment[]
  settings              Setting[]
  createdPolls          Poll[]                 @relation("CreatedPolls")
  pollVotes             PollVote[]
}

model Profile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title               String?
  bio                 String?
  timezone            String   @default("UTC")
  country             String?
  preferredTargetLang String   @default("en")
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token        String   @unique
  expiresAt    DateTime
  ipAddress    String?
  userAgent    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Device {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceName  String
  deviceType  String   // "laptop", "mobile", "tablet"
  os          String?
  browser     String?
  lastSeenAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RoleDefinition {
  id          String           @id @default(uuid())
  name        String           @unique // "ADMIN", "HOST", "MEMBER"
  description String?
  userRoles   UserRole[]
  permissions RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Permission {
  id          String           @id @default(uuid())
  action      String           @unique // "meeting:create", "meeting:mute_all"
  description String?
  roles       RolePermission[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model UserRole {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId      String
  role        RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
}

model RolePermission {
  id           String         @id @default(uuid())
  roleId       String
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime       @default(now())
}

model Organization {
  id          String       @id @default(uuid())
  name        String
  slug        String       @unique
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  teams       Team[]
}

model Team {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  members        TeamMember[]
  meetings       Meeting[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  deletedAt      DateTime?
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  joinedAt  DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Meeting {
  id              String               @id @default(uuid())
  code            String               @unique // "lingua-382-991"
  dailyRoomUrl    String?              // Managed Daily.co Video Room URL
  title           String
  description     String?
  hostId          String
  host            User                 @relation("MeetingHost", fields: [hostId], references: [id])
  teamId          String?
  team            Team?                @relation(fields: [teamId], references: [id])
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  actualStart     DateTime?
  actualEnd       DateTime?
  status          String               @default("SCHEDULED") // SCHEDULED, LIVE, ENDED
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  deletedAt       DateTime?

  settings        MeetingSettings?
  transSettings   MeetingTranslationSettings?
  participants    MeetingParticipant[]
  messages        Message[]
  recordings      Recording[]
  summary         MeetingSummary?
  invitations     MeetingInvitation[]
  reminders       MeetingReminder[]
  callSessions    CallSession[]
  translationSessions TranslationSession[]
  meetingMetrics  MeetingMetric[]
  polls           Poll[]
}

model MeetingSettings {
  id                String   @id @default(uuid())
  meetingId         String   @unique
  meeting           Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  waitingRoomEnabled Boolean @default(false)
  isLocked          Boolean  @default(false)
  muteOnJoin        Boolean  @default(false)
  allowScreenShare  Boolean  @default(true)
  allowChat         Boolean  @default(true)
  allowReactions    Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MeetingTranslationSettings {
  id                String   @id @default(uuid())
  meetingId         String   @unique
  meeting           Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sttEngine         String   @default("whisper-v3")
  ttsEngine         String   @default("piper")
  fallbackTtsEngine String   @default("edge-tts")
  autoTranslateChat Boolean  @default(true)
  defaultSourceLang String   @default("auto")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model MeetingParticipant {
  id             String    @id @default(uuid())
  meetingId      String
  meeting        Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId         String?
  user           User?     @relation(fields: [userId], references: [id])
  guestName      String?
  email          String?
  role           String    @default("PARTICIPANT") // HOST, COHOST, PARTICIPANT
  spokenLanguage String    @default("en")
  targetLanguage String    @default("en")
  inWaitingRoom  Boolean   @default(false)
  isMuted        Boolean   @default(false)
  isVideoOn      Boolean   @default(true)
  status         String    @default("ACCEPTED") // PENDING, ACCEPTED, DECLINED
  joinedAt       DateTime  @default(now())
  leftAt         DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?
}

model Language {
  id            String   @id @default(uuid())
  code          String   @unique // "en", "ja", "hi", "es", "de"
  name          String
  nativeName    String
  sttSupport    Boolean  @default(true)
  ttsSupport    Boolean  @default(true)
  pipersVoiceId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model TranslationSession {
  id                String              @id @default(uuid())
  meetingId         String
  meeting           Meeting             @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  sourceLang        String
  targetLang        String
  startedAt         DateTime            @default(now())
  endedAt           DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  chunks            TranslationChunk[]
  metrics           TranslationMetric[]
}

model TranslationChunk {
  id                   String             @id @default(uuid())
  translationSessionId String
  session              TranslationSession @relation(fields: [translationSessionId], references: [id], onDelete: Cascade)
  speakerId            String
  speakerName          String
  originalText         String
  translatedText       String
  sourceLang           String
  targetLang           String
  sttDurationMs        Int
  nmtDurationMs        Int
  ttsDurationMs        Int
  totalLatencyMs       Int                // P75 <= 2500ms
  timestamp            DateTime           @default(now())
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  speechAudio          SpeechAudio?
  translationHistories TranslationHistory[]
}

model SpeechAudio {
  id                 String           @id @default(uuid())
  translationChunkId String           @unique
  chunk              TranslationChunk @relation(fields: [translationChunkId], references: [id], onDelete: Cascade)
  audioUrl           String?
  format             String           @default("mp3")
  durationSec        Float
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

model TranslationHistory {
  id                 String            @id @default(uuid())
  translationChunkId String?
  chunk              TranslationChunk? @relation(fields: [translationChunkId], references: [id])
  messageId          String?
  message            Message?          @relation(fields: [messageId], references: [id])
  originalText       String
  translatedText     String
  sourceLang         String
  targetLang         String
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model SpeechHistory {
  id          String   @id @default(uuid())
  meetingId   String
  speakerId   String
  transcript  String
  language    String
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id           String               @id @default(uuid())
  meetingId    String
  meeting      Meeting              @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User                 @relation(fields: [senderId], references: [id])
  content      String
  originalLang String               @default("en")
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  deletedAt    DateTime?
  files        File[]
  translations TranslationHistory[]
}

model File {
  id          String   @id @default(uuid())
  messageId   String
  message     Message  @relation(fields: [messageId], references: [id], onDelete: Cascade)
  filename    String
  fileUrl     String
  fileSize    Int
  mimeType    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?
}

model Recording {
  id            String    @id @default(uuid())
  meetingId     String
  meeting       Meeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  userId        String
  user          User      @relation("UserRecordings", fields: [userId], references: [id])
  videoUrl      String
  durationSec   Int
  fileSizeBytes BigInt
  status        String    @default("PROCESSED") // PROCESSING, PROCESSED, FAILED
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
}

model MeetingSummary {
  id               String   @id @default(uuid())
  meetingId        String   @unique
  meeting          Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  title            String
  overview         String
  keyPointsJson    String   // JSON bullet points
  actionItemsJson  String   // JSON action items with assignees
  transcriptJson   String   // Full searchable dual-language transcript
  generatedAt      DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Poll {
  id          String       @id @default(uuid())
  meetingId   String
  meeting     Meeting      @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  creatorId   String
  creator     User         @relation("CreatedPolls", fields: [creatorId], references: [id])
  question    String
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?
  options     PollOption[]
  votes       PollVote[]
}

model PollOption {
  id        String     @id @default(uuid())
  pollId    String
  poll      Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  text      String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  votes     PollVote[]
}

model PollVote {
  id         String     @id @default(uuid())
  pollId     String
  poll       Poll       @relation(fields: [pollId], references: [id], onDelete: Cascade)
  optionId   String
  option     PollOption @relation(fields: [optionId], references: [id], onDelete: Cascade)
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}

model Contact {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation("UserContacts", fields: [userId], references: [id], onDelete: Cascade)
  contactUserId String
  contactUser   User     @relation("ContactOwner", fields: [contactUserId], references: [id], onDelete: Cascade)
  nickname      String?
  isFavorite    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MeetingInvitation {
  id             String   @id @default(uuid())
  meetingId      String
  meeting        Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User     @relation("SentInvitations", fields: [senderId], references: [id])
  recipientEmail String
  status         String   @default("PENDING") // PENDING, ACCEPTED, DECLINED
  sentAt         DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CallHistory {
  id          String   @id @default(uuid())
  callerId    String
  receiverId  String
  callType    String   @default("VIDEO")
  status      String   @default("COMPLETED")
  durationSec Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CallSession {
  id          String      @id @default(uuid())
  meetingId   String
  meeting     Meeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  startedAt   DateTime    @default(now())
  endedAt     DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  events      CallEvent[]
}

model CallEvent {
  id            String      @id @default(uuid())
  callSessionId String
  callSession   CallSession @relation(fields: [callSessionId], references: [id], onDelete: Cascade)
  eventType     String
  participantId String
  timestamp     DateTime    @default(now())
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model MeetingReminder {
  id          String   @id @default(uuid())
  meetingId   String
  meeting     Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  remindAt    DateTime
  channel     String   @default("EMAIL")
  isSent      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Subscription {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan        String    @default("PRO") // FREE, PRO, ENTERPRISE
  status      String    @default("ACTIVE")
  renewsAt    DateTime
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model Payment {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float
  currency    String   @default("USD")
  status      String   @default("SUCCEEDED")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  message     String
  isRead      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
}

model SystemMetric {
  id          String   @id @default(uuid())
  metricName  String
  value       Float
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model TranslationMetric {
  id                   String              @id @default(uuid())
  translationSessionId String?
  translationSession   TranslationSession? @relation(fields: [translationSessionId], references: [id])
  sttLatencyMs         Int
  nmtLatencyMs         Int
  ttsLatencyMs         Int
  totalLatencyMs       Int
  sourceLang           String
  targetLang           String
  timestamp            DateTime            @default(now())
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
}

model MeetingMetric {
  id                String   @id @default(uuid())
  meetingId         String
  meeting         Meeting  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  peakParticipants   Int
  totalDurationMin   Int
  audioQualityScore Float    @default(4.8)
  videoQualityScore Float    @default(4.7)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model ErrorLog {
  id          String   @id @default(uuid())
  service     String   // "webrtc", "translation", "speech", "db", "socket"
  message     String
  stackTrace  String?
  timestamp   DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatAnalytics {
  id                 String   @id @default(uuid())
  totalMessages      Int
  translatedMessages Int
  date               DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model AiMetric {
  id                String   @id @default(uuid())
  modelName         String   // "Whisper-v3", "Piper-TTS", "Edge-TTS"
  sttTimeMs         Int
  translationTimeMs Int
  ttsTimeMs         Int
  costEstimate      Float
  timestamp         DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model LanguageModel {
  id          String   @id @default(uuid())
  name        String
  type        String   // "STT", "NMT", "TTS"
  provider    String   // "Whisper", "Piper", "EdgeTTS"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Setting {
  id                  String   @id @default(uuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  captionSize         String   @default("medium")
  dualCaptionStyle    String   @default("stacked")
  ttsVoiceType        String   @default("female_natural")
  autoPlayTranslation Boolean  @default(true)
  autoTranslateChat   Boolean  @default(true)
  noiseCancellation   Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}
